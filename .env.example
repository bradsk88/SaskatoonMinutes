# Summarizer backend: "extractive" (default), "local", or "claude"
SUMMARIZER_BACKEND=extractive

# Only needed if SUMMARIZER_BACKEND=claude
ANTHROPIC_API_KEY=your-api-key-here

# Only needed if SUMMARIZER_BACKEND=local (defaults to distilbart)
# SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6

FLASK_SECRET_KEY=change-me-to-a-random-string
